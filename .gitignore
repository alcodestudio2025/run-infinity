# Godot 4+ specific ignores
.godot/
/android/
*.translation

# Import cache / OS
.import/
.DS_Store
Thumbs.db
desktop.ini

# Secrets / local env
.env
.env.*
*.pem
*.keystore

# Android debug APK build outputs (never commit binaries)
build/android/*.apk
build/android/*.apk.sha256
build/android/*.aab

# Editor / IDE
.vscode/
.idea/
*.swp
*~
